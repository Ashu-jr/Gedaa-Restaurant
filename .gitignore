# Database & SQLite files (Keep internal data off public/private Git repositories)
hotel_menu.db
*.db
*.sqlite
*.sqlite3

# Secrets & Environment configuration
.env
*.env
*.env.*
*.local

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# OS & Editor generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
